{
  "meta": {
    "presetClass": "fading_truth",
    "presetIntent": "scenario_profile_inh_fr1",
    "presetNotes": "Indoor hotspot FR1 scenario preset with explicit TDL-A fading."
  },
  "scenario": {
    "name": "IndoorHotspot",
    "layout": {
      "type": "grid",
      "nSites": 12,
      "interSiteDistance_m": 40,
      "nSectorsPerSite": 1,
      "wrapAround": false
    },
    "bs": {
      "height_m": 3,
      "nTxAnt": 32,
      "nRxAnt": 32,
      "txPower_dBm": 30,
      "antenna": {
        "type": "URA",
        "size": [
          8,
          4
        ],
        "elementSpacing_wl": [
          0.5,
          0.5
        ]
      }
    },
    "ue": {
      "nUE": 40,
      "distribution": {
        "type": "uniform",
        "indoorFraction": 0.8,
        "minBSdist_m": 2,
        "maxBSdist_m": 50
      }
    },
    "mobility": {
      "enable": true,
      "model": "randomWaypoint",
      "speed_kmh": [
        0,
        3
      ],
      "updatePeriod_s": 0.1
    }
  },
  "channel": {
    "type": "TR38901",
    "fc_Hz": 6000000000.0,
    "bandwidth_Hz": 100000000.0,
    "subcarrierSpacing_kHz": 30,
    "pathloss": {
      "model": "ABG",
      "shadowFadingStd_dB": 4,
      "o2iLoss_dB": 15
    },
    "fading": {
      "enable": true,
      "model": "TDL",
      "profile": "TDL-A",
      "delaySpread_s": 5e-08,
      "maxDoppler_Hz": 5
    }
  },
  "phy": {
    "carrier": {
      "SubcarrierSpacing": 30,
      "NSizeGrid": 273,
      "CyclicPrefix": "normal"
    },
    "duplex": {
      "mode": "TDD",
      "tddCommon": {
        "ReferenceSubcarrierSpacingKHz": 30,
        "Pattern1": {
          "PeriodicityMilliseconds": 2.5,
          "NumDownlinkSlots": 3,
          "NumDownlinkSymbols": 12,
          "NumUplinkSlots": 1,
          "NumUplinkSymbols": 1
        }
      }
    },
    "waveform": {
      "type": "DFT-s-OFDM",
      "dl": "CP-OFDM",
      "ul": "DFT-s-OFDM"
    },
    "pusch": {
      "transformPrecoding": true
    },
    "prach": {
      "configurationIndex": 69,
      "subcarrierSpacing_kHz": 30,
      "preambleFormat": "A1"
    },
    "ul": {
      "pusch": {
        "TransformPrecoding": true
      }
    }
  }
}
