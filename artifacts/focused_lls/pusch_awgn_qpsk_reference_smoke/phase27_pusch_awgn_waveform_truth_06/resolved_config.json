    "ptrs": {
      "enabled": false
    }
  },
  "channel": {
    "model": "AWGN",
    "delaySpreadSeconds": 0,
    "velocityKmph": 0,
    "txAntennas": 1,
    "rxAntennas": 1,
    "seed": 2.026081E+7,
    "normalization": "occupied_re_esn0"
  },
  "receiver": {
    "channelEstimation": "perfect",
    "equalizer": "MMSE",
    "ldpcMaxIterations": 50,
    "ldpcAlgorithm": "Normalized min-sum"
  },
  "harq": {
    "enabled": false
  },
  "linkAdaptation": {
    "enabled": false
  },
  "comparison": {
    "targetBLER": [
      0.1,
      0.01,
      0.001
