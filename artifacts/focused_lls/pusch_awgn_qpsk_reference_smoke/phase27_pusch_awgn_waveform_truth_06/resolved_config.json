{
  "schemaVersion": "sixgr.lls.config/v1",
  "scenario": {
    "id": "pusch_awgn_qpsk_reference_smoke",
    "description": "Dedicated short diagnostic of the same waveform chain; not publication statistics"
  },
  "simulation": {
    "mode": "LLS",
    "link": "PUSCH",
