  "pusch": {
    "modulation": "QPSK",
    "tbsMode": "derived_from_exact_allocation",
    "mcsIndex": 4,
    "targetCodeRate": 0.3,
    "numberLayers": 1,
    "numberAntennaPorts": 1,
    "transmissionScheme": "nonCodebook",
    "transformPrecoding": false,
    "rnti": 1,
    "nid": 1,
