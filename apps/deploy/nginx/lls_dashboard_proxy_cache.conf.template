worker_processes  auto;

events {
    worker_connections  8192;
}

http {
    include       mime.types;
    default_type  application/octet-stream;

    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout  65;
    server_tokens   off;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/json
        application/javascript
        application/xml
        application/xml+rss
        image/svg+xml;

    proxy_cache_path __CACHE_ROOT__ levels=1:2 keys_zone=sixgr_artifact_cache:256m max_size=32g inactive=365d use_temp_path=off;

    upstream sixgr_dashboard_backend {
        server 127.0.0.1:__BACKEND_PORT__;
        keepalive 64;
    }

    server {
        listen       __FRONTEND_PORT__;
        server_name  _;

        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer-when-downgrade always;

        location /artifact/ {
            proxy_pass http://sixgr_dashboard_backend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection "";

            proxy_cache sixgr_artifact_cache;
            proxy_cache_key $scheme$proxy_host$request_uri;
            proxy_cache_lock on;
            proxy_cache_background_update on;
            proxy_cache_revalidate on;
            proxy_cache_valid 200 206 301 302 365d;
            proxy_ignore_headers Set-Cookie;
            proxy_hide_header Set-Cookie;

            add_header X-Cache-Status $upstream_cache_status always;
        }

        location / {
            proxy_pass http://sixgr_dashboard_backend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection "";
            proxy_buffering on;
        }
    }
}
