# Copy this file to apps/.env and keep the real file local.
# The single browser WebGUI reads these MySQL settings on every launch.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=sixgr_results
MYSQL_CONNECT_TIMEOUT=3

# Browser listener. Keep 127.0.0.1 for local-only access.
SIXGR_DASHBOARD_HOST=127.0.0.1
SIXGR_DASHBOARD_PORT=62906
# SIXGR_DASHBOARD_PUBLIC_HOST=simulator-host.example.org
SIXGR_DASHBOARD_SERVER=auto
SIXGR_DASHBOARD_THREADS=32

# Optional machine-specific overrides.
# SIXGR_MATLAB_EXE=C:\Program Files\MATLAB\R2026a\bin\matlab.exe
# SIXGR_RESULTS_ROOT=C:\path\to\sixgr-results
