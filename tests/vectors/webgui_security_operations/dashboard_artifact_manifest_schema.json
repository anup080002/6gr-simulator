{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sixgr.local/schemas/artifact-manifest-v1.json",
  "title": "6GR run artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "run_tag",
    "config_revision_id",
    "resolved_config_sha256",
    "created_utc",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "2026-07-27.artifact-manifest.v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "run_tag": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "config_revision_id": {
      "type": "string"
    },
    "resolved_config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "relative_path",
          "kind",
          "sha256",
          "bytes",
          "provenance",
          "validity"
        ],
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "relative_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.).+$"
          },
          "kind": {
            "enum": [
              "csv",
              "png",
              "json",
              "yaml",
              "mat",
              "md",
              "log",
              "txt",
              "parquet",
              "other"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "mime_type": {
            "type": "string"
          },
          "schema_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_artifact_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "plot_recipe_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "provenance": {
            "enum": [
              "observed_runtime",
              "decoded_runtime",
              "derived_from_observed",
              "external_oracle",
              "configured",
              "reconstructed_diagnostic",
              "unavailable"
            ]
          },
          "validity": {
            "enum": [
              "real_lls_evidence",
              "runtime_measured",
              "diagnostic_only",
              "unavailable",
              "invalid_stale"
            ]
          },
          "unavailable_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "generated_utc": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    }
  }
}