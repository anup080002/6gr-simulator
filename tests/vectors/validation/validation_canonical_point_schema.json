{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sixgr://schemas/validation/campaign-point/1.0.0",
  "title": "6GR canonical validation campaign point",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "SchemaVersion",
    "RunID",
    "TaskID",
    "RunClass",
    "Direction",
    "ProfileID",
    "ChannelModel",
    "CarrierFrequency_Hz",
    "Bandwidth_Hz",
    "SCS_kHz",
    "MCS",
    "Rank",
    "Receiver",
    "SNR_dB",
    "IndependentDropID",
    "Seed",
    "TrialCount",
    "ErrorCount",
    "Estimate",
    "CILow",
    "CIHigh",
    "ConfidenceLevel",
    "IntervalMethod",
    "PointStatus",
    "StopReason",
    "MeasuredSINR_dB",
    "MeasuredSINRProvenance",
    "MeasuredSINRSampleCount",
    "SourceCommit",
    "ScenarioSHA256"
  ],
  "properties": {
    "SchemaVersion": {
      "const": "1.0.0"
    },
    "RunID": {
      "type": "string",
      "minLength": 1
    },
    "TaskID": {
      "type": "string",
      "minLength": 1
    },
    "RunClass": {
      "enum": [
        "FIXED_LINK_CALIBRATION",
        "GEOMETRY_LINK_LEVEL",
        "SYSTEM_LEVEL",
        "CONTROL_ONLY",
        "PROTOCOL_SYSTEM_STUDY"
      ]
    },
    "Direction": {
      "enum": [
        "DL",
        "UL"
      ]
    },
    "ProfileID": {
      "type": "string",
      "minLength": 1
    },
    "ChannelModel": {
      "type": "string",
      "minLength": 1
    },
    "CarrierFrequency_Hz": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "Bandwidth_Hz": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "SCS_kHz": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "MCS": {
      "type": "integer",
      "minimum": 0
    },
    "Rank": {
      "type": "integer",
      "minimum": 1
    },
    "Receiver": {
      "type": "string",
      "minLength": 1
    },
    "SNR_dB": {
      "type": "number"
    },
    "IndependentDropID": {
      "type": "string",
      "minLength": 1
    },
    "Seed": {
      "type": "integer",
      "minimum": 0
    },
    "TrialCount": {
      "type": "integer",
      "minimum": 0
    },
    "ErrorCount": {
      "type": "integer",
      "minimum": 0
    },
    "Estimate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "CILow": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "CIHigh": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "ConfidenceLevel": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1
    },
    "IntervalMethod": {
      "enum": [
        "WILSON_TWO_SIDED",
        "CLOPPER_PEARSON_TWO_SIDED",
        "CLOPPER_PEARSON_ONE_SIDED_UPPER"
      ]
    },
    "PointStatus": {
      "enum": [
        "NOT_STARTED",
        "RUNNING",
        "COMPLETE",
        "CENSORED_COMPLETE",
        "INCOMPLETE_MAX_TRIALS",
        "FAILED_SCHEMA",
        "FAILED_ORACLE",
        "FAILED_PROVENANCE",
        "FAILED_STATISTICS",
        "BLOCKED_TOOLCHAIN",
        "SKIPPED_NOT_APPLICABLE"
      ]
    },
    "StopReason": {
      "enum": [
        "NONE",
        "MIN_TRIALS_NOT_MET",
        "MIN_ERRORS_AND_CI_MET",
        "ZERO_ERROR_UPPER_BOUND_MET",
        "MAX_TRIALS_REACHED_INCOMPLETE",
        "MAX_TRIALS_REACHED_CENSORED_PASS",
        "MAX_RUNTIME_REACHED",
        "INVALID_CONFIGURATION",
        "NUMERICAL_FAILURE",
        "ORACLE_FAILURE",
        "PROVENANCE_FAILURE",
        "DUPLICATE_TASK_CONFLICT",
        "STALE_ARTIFACT",
        "TOOLCHAIN_UNAVAILABLE",
        "USER_ABORT"
      ]
    },
    "MeasuredSINR_dB": {
      "type": "number"
    },
    "MeasuredSINRProvenance": {
      "enum": [
        "OBSERVED_RUNTIME_STATE",
        "DERIVED_FROM_OBSERVED_RUNTIME_STATE",
        "DECODED_RECEIVER_STATE"
      ]
    },
    "MeasuredSINRSampleCount": {
      "type": "integer",
      "minimum": 1
    },
    "SourceCommit": {
      "type": "string",
      "minLength": 7
    },
    "ScenarioSHA256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}