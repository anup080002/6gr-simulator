+                passed=true; status="not_applicable"; errors=false(0,1);
+            end
+            reason=""; if ~passed, reason="uci_crc_failed"; end
+            result=struct('Bits',int8(bits(:)),'Plan',plan,'CRCPassed',logical(passed), ...
