+++ b/tests/testSharedPUCCHJointReceiver.m
@@ -0,0 +1,81 @@
+function ok=testSharedPUCCHJointReceiver()
+% Actual shared PUCCH/SRS/CSI-RS execution, with declared UE CSI/access boundary.
+% No statistical qualification claim or injected receiver payload/variance.
+path='simulator/configs/scenarios/lls_pucch_flat_joint_shared_fixture.yaml';
+s=sixgr.lls6g.config.loadScenarioConfig(path);
+cfg=sixgr.lls6g.buildInternalConfig(s,tempname);
+s=s.toStruct();
+assert(isequaln(cfg.phy.pucch.format2ShortUCIReceiverPolicy,s.pucch.format2_short_uci_receiver_policy));
+for change=["zero_alpha","unit_alpha","zero_posterior","wrong_algorithm","missing_probability","no_explicit_channel","baseline_claim"]
+    bad=s;
+    switch change
+        case "zero_alpha", bad.pucch.format2_short_uci_receiver_policy.target_false_alarm_probability=0;
+        case "unit_alpha", bad.pucch.format2_short_uci_receiver_policy.target_false_alarm_probability=1;
+        case "zero_posterior", bad.pucch.format2_short_uci_receiver_policy.minimum_word_posterior=0;
+        case "wrong_algorithm", bad.pucch.format2_short_uci_receiver_policy.algorithm="undefined";
+        case "missing_probability", bad.pucch.format2_short_uci_receiver_policy=rmfield(bad.pucch.format2_short_uci_receiver_policy,'minimum_word_posterior');
+        case "no_explicit_channel", bad.channels.shared_identity_awgn_enabled=false;
+        case "baseline_claim", bad.meta.research_class='baseline_benchmark';
+    end
+    rejected=false;
+    try, sixgr.lls6g.config.validateScenarioConfig(bad); catch cause
+        assert(startsWith(string(cause.identifier),"sixgr:lls6g:")); rejected=true;
+    end
+    assert(rejected,'test:InvalidJointReceiverConfigAccepted','Invalid policy %s was accepted.',change);
+end
+states=cell(3,1); modes=["present","remove_after_tx","absent"];
+for k=1:numel(modes)
+    [passed,state]=testSharedPeriodicCSIProducer(modes(k),true,path); assert(passed);
+    states{k}=state; receipt=state.SharedGNBUCIReceptions{1}; rx=receipt.Receiver;
+    trial=state.ControlTrials.PUCCH;
+    assert(state.CurrentSNR_dB==cfg.channel.snr_dB, ...
+        'test:SharedJointSNRStateMismatch','The fixture slot state must use its actual configured operating point.');
+    assert(trial.ConfiguredSNR_dB==cfg.channel.snr_dB && trial.AppliedAWGNSNR_dB==cfg.channel.snr_dB && ...
+        trial.ReceiverNoiseAuditAvailable && ~trial.ReceiverNoiseAuditEstimatorInput && ...
+        trial.InjectedNoiseVariancePreCompositeFrontEnd>0, ...
+        'test:SharedJointSNRExportMismatch','All producer modes must export the actual fixed-AWGN noise reference.');
+    assert(abs(trial.AWGNReferenceEnergyPerOccupiedRE / ...
+        (trial.InjectedNoiseVariancePreCompositeFrontEnd*trial.SampleToGridNoiseVarianceGain)-10^(cfg.channel.snr_dB/10))<1e-8);
+    assert(rx.DecoderAlgorithm=="flat_joint_short_uci_v1" && rx.ShortUCIReceiverEvidence.Applied && ...
+        rx.ReceiveTiming.PriorClockApplied && ~rx.PreparedTransmitterConsumed && ...
+        ~rx.InjectedNoiseVarianceConsumed && ~rx.InjectedInterferenceCovarianceConsumed && ...
+        ~rx.ReceiverObservationModel.PayloadOrChannelCoefficientsRetained);
+    assert(startsWith(rx.DetectionThresholdSource,"yaml.pucch.format2_short_uci_receiver_policy.") && ...
+        trial.DetectionThresholdSource==rx.DetectionThresholdSource && ...
+        trial.ShortUCIConditionalWordPosterior==rx.ShortUCIReceiverEvidence.ConditionalWordPosterior && ...
+        trial.ShortUCIWordConfidencePassed==rx.ShortUCIReceiverEvidence.WordAccepted && ...
+        ~trial.ShortUCIPhysicalQualificationPassed);
+    assert(trial.DecodeNoiseInterferenceVarianceRole=="equalized_receiver_comparison_not_joint_decoder_variance");
+    assert(trial.GridNoiseVarianceValueRole=="received_DMRS_equalizer_comparison_not_joint_decoder_input");
+    item=state.TestReceivedPUCCHItem;
+    model=rx.ReceiverObservationModel;
+    plane=item.Planes(string({item.Planes.ReceiverID})==model.ReceiverID+":post_rf");
+    actualInput=sixgr.phy.rx.compensateReceivedAGC(plane.Observation,plane.Segments,model.ReceiverID);
+    replay=sixgr.link.receivePUCCHObservation(item.Context.Config,receipt.Assignment,receipt.Context, ...
+        actualInput,state.ReceivedULTimingReferences{1},rx.ReceiverExecutionContext);
+    for field=["DecodedSequence1","DecodedSequence2","DetectionMetric","DetectionThreshold","ReceiverUsable","DTX"]
+        assert(isequaln(rx.(field),replay.(field)),'test:JointReplayMismatch','Retained receiver-only inputs changed %s.',field);
+    end
+    % Roundtrip the primary table, preserving actual confidence and roles.
+    folder=fullfile(state.RunFolder,'joint_receiver_checks'); if ~isfolder(folder), mkdir(folder); end
+    csv=fullfile(folder,'pucch_joint_receiver.csv'); writetable(trial,csv);
+    persisted=readtable(csv,'TextType','string');
+    assert(persisted.DecoderAlgorithm==trial.DecoderAlgorithm && ...
+        abs(persisted.ShortUCIConditionalWordPosterior-trial.ShortUCIConditionalWordPosterior)<1e-12 && ...
+        persisted.ShortUCIPhysicalQualificationPassed==trial.ShortUCIPhysicalQualificationPassed && ...
+        persisted.DecodeNoiseInterferenceVarianceRole==trial.DecodeNoiseInterferenceVarianceRole);
+    if modes(k)~="absent", assert(rx.ReceiverUsable && ~rx.DTX); end
+    % Saved IQ can be replayed with the sanitized model metadata. It does not
+    % preserve a TX payload/H/noise-variance oracle as receiver configuration.
+    serialized=string(jsonencode(rx.ReceiverObservationModel));
+    assert(~contains(serialized,'"InjectedNoiseVariance":') && ...
+        ~contains(serialized,'"ChannelCoefficients":') && ~contains(serialized,'"PayloadBits":'));
+    fprintf('SHARED_JOINT_RECEIVER_CASE mode=%s DTX=%d usable=%d posterior=%.9g threshold=%.9g\n', ...
+        modes(k),rx.DTX,rx.ReceiverUsable,rx.ShortUCIReceiverEvidence.ConditionalWordPosterior,rx.DetectionThreshold);
+end
+a=removevars(states{1}.SharedGNBCSIReportTable,'UEReferenceRecordJSON');
+b=removevars(states{2}.SharedGNBCSIReportTable,'UEReferenceRecordJSON');
+assert(isequaln(a,b),'Removing UE producer state must not change gNB reception.');
+fprintf('SHARED_JOINT_RECEIVER_PASS actual_shared_stream=1 producer_modes=3 detector_qualified=0\n');
+ok=true;
+end
diff --git a/+sixgr/+link/receivedControlNoiseAudit.m b/+sixgr/+link/receivedControlNoiseAudit.m
new file mode 100644
--- /dev/null
+++ b/+sixgr/+link/receivedControlNoiseAudit.m
@@ -0,0 +1,96 @@
+function audit=receivedControlNoiseAudit(cfg,observation,segments,receiverID,configuredSNR)
+% Post-decode noise-reference audit for a real receive window, even with no TX.
+% These injected variances are NOT receiver estimates and never decode inputs.
+id='sixgr:link:MissingControlNoiseExecution';
+assert(isa(observation,'sixgr.phy.waveform.WaveformObservationBuffer') && ...
+    isscalar(observation) && observation.isComplete() && iscell(segments) && ~isempty(segments), ...
+    id,'Require the completed receive observation and its executed segments.');
+validateattributes(configuredSNR,{'numeric'},{'scalar','real','finite'});
+assert(isequal(double(configuredSNR),double(cfg.channel.snr_dB)), ...
+    'sixgr:link:ControlNoiseOperatingPointMismatch', ...
+    'Active control operating point must equal the resolved physical configuration.');
+fields={'ControlNoiseAuditSchemaVersion','NoiseOperatingMode','NoiseStreamSeed','InjectedNoiseVariance', ...
+    'InjectedNoiseVarianceDomain','NoiseVarianceSource','AppliedAWGNSNR_dB', ...
+    'AppliedAWGNSNRSource','AppliedAWGNSNRValueRole','RequestedAWGNReferenceSNR_dB', ...
+    'SignalEnergyPerOccupiedRE','AWGNReferenceEnergySource','ReferenceAWGNGridNoiseVariance', ...
+    'ReferenceAWGNSampleNoiseVariance','SampleToGridNoiseVarianceGain', ...
+    'SharedNoiseCalibrationSource','ThermalSampleNoiseBandwidth_Hz','ThermalNoisePSD_mWPerHz'};
+records=struct([]); intervals=zeros(numel(segments),2);
+for k=1:numel(segments)
+    segment=segments{k};
+    assert(isstruct(segment) && isscalar(segment) && ...
+        all(isfield(segment,{'Execution','StartSample','EndSampleExclusive'})) && ...
+        isfield(segment.Execution,'RX'),id,'Require actual receiver execution and clock records.');
+    nodes=segment.Execution.RX;
+    assert(isstruct(nodes) && all(isfield(nodes,{'ID','Replay'})),id,'Missing receiver identities.');
+    node=nodes(string({nodes.ID})==string(receiverID));
+    assert(isscalar(node) && isstruct(node.Replay) && isscalar(node.Replay) && ...
+        all(isfield(node.Replay,fields)),id,'Require each executed noise ledger field; no configuration substitutes.');
+    r=struct();
+    for f=fields, r.(f{1})=node.Replay.(f{1}); end
+    intervals(k,:)=[segment.StartSample segment.EndSampleExclusive];
+    if k==1, records=r; else, records(k)=r; end
+end
+assert(all(isfinite(intervals) & intervals==fix(intervals) & intervals>=0,'all') && ...
+    all(intervals(:,2)>intervals(:,1)) && ...
+    intervals(1,1)<=observation.StartSample && intervals(end,2)>=observation.EndSampleExclusive && ...
+    all(intervals(:,2)>observation.StartSample & intervals(:,1)<observation.EndSampleExclusive) && ...
+    all(intervals(2:end,1)==intervals(1:end-1,2)), ...
+    id,'Noise ledger must cover the same complete receive interval without gaps or overlap.');
+for f=fields
+    values={records.(f{1})};
+    assert(all(cellfun(@(v)isequaln(v,values{1}),values)), ...
+        'sixgr:link:ControlNoiseChangedWithinObservation', ...
+        'Do not flatten time-varying receiver noise-reference field %s.',f{1});
+end
+r=records(1);
+assert(isequal(r.ControlNoiseAuditSchemaVersion,1), ...
+    'sixgr:link:ControlNoiseAuditSchemaMismatch','Only the executed v1 noise-reference schema is supported.');
+variance=double(r.InjectedNoiseVariance);
+assert(isfinite(variance) && isscalar(variance) && isreal(variance) && variance>0 && ...
+    string(r.InjectedNoiseVarianceDomain)=="receiver_sample_waveform_pre_composite_front_end", ...
+    'sixgr:link:ControlNoisePlaneMismatch','Executed injected variance must identify the pre-RF sample plane.');
+mode=string(r.NoiseOperatingMode);
+if mode=="standalone_awgn_snr_argument"
+    gain=double(r.SampleToGridNoiseVarianceGain); energy=double(r.SignalEnergyPerOccupiedRE);
+    assert(isscalar(gain) && isfinite(gain) && gain>0 && ...
+        isscalar(energy) && isfinite(energy) && energy>0, ...
+        'sixgr:link:ControlNoiseCalibrationMismatch','Fixed-reference energy and OFDM variance transform are required.');
+    applied=10*log10(energy/(variance*gain));
+    [expectedEnergy,policy]=sixgr.link.resolveAWGNReferenceEnergy(cfg);
+    assert(abs(applied-configuredSNR)<=1e-10 && abs(applied-r.AppliedAWGNSNR_dB)<=1e-10 && ...
+        abs(applied-r.RequestedAWGNReferenceSNR_dB)<=1e-10 && ...
+        abs(r.ReferenceAWGNGridNoiseVariance-variance*gain)<=1e-10*variance*gain && ...
+        abs(r.ReferenceAWGNSampleNoiseVariance-variance)<=1e-10*variance && ...
+        energy==expectedEnergy && string(r.SharedNoiseCalibrationSource)==policy.CalibrationSource, ...
+        'sixgr:link:ControlNoiseCalibrationMismatch', ...
+        'Applied fixed-AWGN reference must close through executed sample variance, OFDM transform and the active point.');
+elseif mode=="receiver_noise_figure_thermal_noise"
+    thermal=double(r.ThermalSampleNoiseBandwidth_Hz)*double(r.ThermalNoisePSD_mWPerHz);
+    assert(isfinite(thermal) && thermal>0 && abs(thermal-variance)<=1e-10*variance && ...
+        isnan(r.AppliedAWGNSNR_dB), ...
+        'sixgr:link:ControlNoiseCalibrationMismatch','Thermal execution must close as PSD times bandwidth, not a configured SNR.');
+else
+    error('sixgr:link:ControlNoiseModeUnsupported','Unsupported executed noise mode %s.',mode);
+end
+% Do not overwrite a practical receiver's generic variance/source pair.
+% The injected source is retained only with its explicitly scoped value.
+audit=rmfield(r,{'InjectedNoiseVariance','InjectedNoiseVarianceDomain', ...
+    'SignalEnergyPerOccupiedRE','NoiseVarianceSource'});
+audit.ConfiguredSNR_dB=double(configuredSNR);
+audit.ConfiguredSNRSource="resolved_active_operating_point_not_measured_receiver_SINR";
+audit.AWGNReferenceEnergyPerOccupiedRE=r.SignalEnergyPerOccupiedRE;
+audit.AWGNReferenceEnergyValueRole="fixed_reference_not_measured_desired_signal_energy";
+audit.InjectedNoiseVariancePreCompositeFrontEnd=variance;
+audit.InjectedNoiseVariancePreCompositeFrontEndDomain=string(r.InjectedNoiseVarianceDomain);
+audit.InjectedNoiseVariancePreCompositeFrontEndSource=string(r.NoiseVarianceSource);
+audit.ReferenceAWGNGridNoiseVarianceDomain="equivalent_OFDM_grid_of_pre_front_end_injected_noise";
+audit.ReceiverNoiseAuditSource="actual_completed_receiver_execution_segments_no_TX_dependency";
+audit.ReceiverNoiseAuditEstimatorInput=false;
+audit.ReceiverNoiseAuditAvailable=true;
+audit.ReceiverNoiseAuditStatus="executed_reference_calibration_verified";
+audit.ReceiverNoiseAuditStartSample=observation.StartSample;
+audit.ReceiverNoiseAuditEndSampleExclusive=observation.EndSampleExclusive;
+audit.ReceiverNoiseAuditSampleRateHz=observation.SampleRateHz;
+audit.ReceiverNoiseAuditSegmentCount=numel(segments);
+end
diff --git a/tests/testReceivedControlNoiseAudit.m b/tests/testReceivedControlNoiseAudit.m
new file mode 100644
--- /dev/null
+++ b/tests/testReceivedControlNoiseAudit.m
@@ -0,0 +1,120 @@
+function ok=testReceivedControlNoiseAudit()
+% Ledger-contract test. Declared metadata is not physical qualification.
+setup6GRSimToolkit('Verbose',false,'RunToolboxChecks',false);
+cfg=struct('channel',struct('snr_dB',20,'awgnReferenceREEnergy',0.25));
+obs=sixgr.phy.waveform.WaveformObservationBuffer(10,30,7680000,2);
+obs.append(sixgr.phy.waveform.WaveformChunk(complex(zeros(20,2)),10),obs.SampleRateHz);
+for point=[-30 -20 -10 0 10 20 30 40]
+    cfg.channel.snr_dB=point;
+    segments=ledgerFixture(cfg);
+    actual=sixgr.link.receivedControlNoiseAudit(cfg,obs,segments,"rx",point);
+    assert(abs(actual.AppliedAWGNSNR_dB-point)<1e-10 && actual.ConfiguredSNR_dB==point);
+    assert(actual.ReceiverNoiseAuditAvailable && ~actual.ReceiverNoiseAuditEstimatorInput && ...
+        actual.ReceiverNoiseAuditSegmentCount==2);
+    assert(actual.ReceiverNoiseAuditStartSample==10 && actual.ReceiverNoiseAuditEndSampleExclusive==30);
+    assert(abs(actual.AWGNReferenceEnergyPerOccupiedRE / ...
+        (actual.InjectedNoiseVariancePreCompositeFrontEnd*actual.SampleToGridNoiseVarianceGain) / ...
+        10^(point/10)-1)<1e-12);
+end
+cfg.channel.snr_dB=20; segments=ledgerFixture(cfg);
+% A stale runtime slot label must not relabel a physical owner's different
+% configured noise point, as in the shared-CSI fixture's old 60/12 dB split.
+physicalCfg=cfg; physicalCfg.channel.snr_dB=60;
+staleCfg=cfg; staleCfg.channel.snr_dB=12;
+reject(@()sixgr.link.receivedControlNoiseAudit(staleCfg,obs, ...
+    ledgerFixture(physicalCfg),"rx",12),"ControlNoiseCalibrationMismatch");
+expected=sixgr.link.receivedControlNoiseAudit(cfg,obs,segments,"rx",20);
+poison=segments;
+for k=1:numel(poison)
+    poison{k}.Execution.TX=struct('PayloadBits',int8([1 0 1]),'Waveform',Inf);
+    poison{k}.Execution.Links=struct('ChannelCoefficients',complex(NaN),'ReceivedPower',Inf);
+end
+assert(isequaln(expected,sixgr.link.receivedControlNoiseAudit(cfg,obs,poison,"rx",20)));
+measured=struct('NoiseVariance',0.123,'GridNoiseVariance',0.456, ...
+    'NoiseVarSource',"received_DMRS",'NoiseVarianceSource',"received_DMRS");
+merged=sixgr.util.mergeStruct(measured,expected);
+assert(merged.NoiseVariance==measured.NoiseVariance && merged.GridNoiseVariance==measured.GridNoiseVariance && ...
+    merged.NoiseVarSource==measured.NoiseVarSource && ...
+    merged.NoiseVarianceSource==measured.NoiseVarianceSource && ~isfield(expected,'NoiseVarianceSource'), ...
+    'Audit must not overwrite practical estimates or their source labels.');
+
+thermal=segments;
+for k=1:numel(thermal)
+    r=thermal{k}.Execution.RX.Replay;
+    r.NoiseOperatingMode="receiver_noise_figure_thermal_noise";
+    r.InjectedNoiseVariance=1e-6;
+    r.NoiseVarianceSource="receiver_thermal_noise_plus_nf_absolute_sqrt_mW";
+    r.ThermalSampleNoiseBandwidth_Hz=1e6; r.ThermalNoisePSD_mWPerHz=1e-12;
+    r.AppliedAWGNSNR_dB=NaN; r.AppliedAWGNSNRSource="not_applicable_thermal_noise";
+    r.RequestedAWGNReferenceSNR_dB=NaN; r.SignalEnergyPerOccupiedRE=NaN;
+    r.AWGNReferenceEnergySource="not_applicable_thermal_noise";
+    r.ReferenceAWGNGridNoiseVariance=NaN; r.ReferenceAWGNSampleNoiseVariance=NaN;
+    r.SampleToGridNoiseVarianceGain=NaN; r.SharedNoiseCalibrationSource="";
+    thermal{k}.Execution.RX.Replay=r;
+end
+t=sixgr.link.receivedControlNoiseAudit(cfg,obs,thermal,"rx",20);
+assert(isnan(t.AppliedAWGNSNR_dB) && t.InjectedNoiseVariancePreCompositeFrontEnd==1e-6);
+
+reject(@()sixgr.link.receivedControlNoiseAudit(cfg,obs,segments,"rx",10),"ControlNoiseOperatingPointMismatch");
+reject(@()sixgr.link.receivedControlNoiseAudit(cfg,obs,segments,"wrong_rx",20),"MissingControlNoiseExecution");
+bad=segments; bad{2}.StartSample=21;
+reject(@()sixgr.link.receivedControlNoiseAudit(cfg,obs,bad,"rx",20),"MissingControlNoiseExecution");
+bad=segments; bad{2}.StartSample=19;
+reject(@()sixgr.link.receivedControlNoiseAudit(cfg,obs,bad,"rx",20),"MissingControlNoiseExecution");
+bad=segments; bad{1}.Execution.RX.Replay=rmfield(bad{1}.Execution.RX.Replay,'InjectedNoiseVariance');
+reject(@()sixgr.link.receivedControlNoiseAudit(cfg,obs,bad,"rx",20),"MissingControlNoiseExecution");
+bad=segments; bad{1}.Execution.RX=[bad{1}.Execution.RX bad{1}.Execution.RX];
+reject(@()sixgr.link.receivedControlNoiseAudit(cfg,obs,bad,"rx",20),"MissingControlNoiseExecution");
+bad=segments; bad{2}.Execution.RX.Replay.NoiseStreamSeed=22;
+reject(@()sixgr.link.receivedControlNoiseAudit(cfg,obs,bad,"rx",20),"ControlNoiseChangedWithinObservation");
+bad=replaceField(segments,'InjectedNoiseVariance',2*segments{1}.Execution.RX.Replay.InjectedNoiseVariance);
+reject(@()sixgr.link.receivedControlNoiseAudit(cfg,obs,bad,"rx",20),"ControlNoiseCalibrationMismatch");
+bad=replaceField(segments,'AppliedAWGNSNR_dB',21);
+reject(@()sixgr.link.receivedControlNoiseAudit(cfg,obs,bad,"rx",20),"ControlNoiseCalibrationMismatch");
+bad=replaceField(segments,'InjectedNoiseVariance',-1);
+reject(@()sixgr.link.receivedControlNoiseAudit(cfg,obs,bad,"rx",20),"ControlNoisePlaneMismatch");
+bad=replaceField(segments,'InjectedNoiseVarianceDomain',"post_equalizer");
+reject(@()sixgr.link.receivedControlNoiseAudit(cfg,obs,bad,"rx",20),"ControlNoisePlaneMismatch");
+bad=replaceField(segments,'NoiseOperatingMode',"unknown");
+reject(@()sixgr.link.receivedControlNoiseAudit(cfg,obs,bad,"rx",20),"ControlNoiseModeUnsupported");
+bad=replaceField(thermal,'ThermalNoisePSD_mWPerHz',2e-12);
+reject(@()sixgr.link.receivedControlNoiseAudit(cfg,obs,bad,"rx",20),"ControlNoiseCalibrationMismatch");
+bad=segments; bad{1}.Execution.RX.Replay=rmfield(bad{1}.Execution.RX.Replay,'ControlNoiseAuditSchemaVersion');
+reject(@()sixgr.link.receivedControlNoiseAudit(cfg,obs,bad,"rx",20),"MissingControlNoiseExecution");
+bad=replaceField(segments,'ControlNoiseAuditSchemaVersion',2);
+reject(@()sixgr.link.receivedControlNoiseAudit(cfg,obs,bad,"rx",20),"ControlNoiseAuditSchemaMismatch");
+incomplete=sixgr.phy.waveform.WaveformObservationBuffer(10,30,obs.SampleRateHz,2);
+reject(@()sixgr.link.receivedControlNoiseAudit(cfg,incomplete,segments,"rx",20),"MissingControlNoiseExecution");
+fprintf('RECEIVED_CONTROL_NOISE_AUDIT_PASS fixed_points=8 thermal=1 stale_slot_noise_point_rejected=1 TX_dependency=0 metadata_fixture_only=1\n');
+ok=true;
+end
+
+function segments=ledgerFixture(cfg)
+[energy,policy]=sixgr.link.resolveAWGNReferenceEnergy(cfg);
+gain=64; grid=energy/10^(cfg.channel.snr_dB/10); sample=grid/gain;
+r=struct('ControlNoiseAuditSchemaVersion',1,'NoiseOperatingMode',"standalone_awgn_snr_argument",'NoiseStreamSeed',11, ...
+    'InjectedNoiseVariance',sample,'InjectedNoiseVarianceDomain',"receiver_sample_waveform_pre_composite_front_end", ...
+    'NoiseVarianceSource',policy.NoiseVarianceSource,'AppliedAWGNSNR_dB',cfg.channel.snr_dB, ...
+    'AppliedAWGNSNRSource',"executed_sample_noise_variance_and_occupied_re_energy", ...
+    'AppliedAWGNSNRValueRole',"applied_noise_reference_not_measured_receiver_sinr", ...
+    'RequestedAWGNReferenceSNR_dB',cfg.channel.snr_dB,'SignalEnergyPerOccupiedRE',energy, ...
+    'AWGNReferenceEnergySource',policy.EnergySource,'ReferenceAWGNGridNoiseVariance',grid, ...
+    'ReferenceAWGNSampleNoiseVariance',sample,'SampleToGridNoiseVarianceGain',gain, ...
+    'SharedNoiseCalibrationSource',policy.CalibrationSource, ...
+    'ThermalSampleNoiseBandwidth_Hz',NaN,'ThermalNoisePSD_mWPerHz',NaN);
+execution=struct('RX',struct('ID',"rx",'Replay',r));
+segments={struct('StartSample',0,'EndSampleExclusive',20,'Execution',execution), ...
+    struct('StartSample',20,'EndSampleExclusive',40,'Execution',execution)};
+end
+
+function segments=replaceField(segments,field,value)
+for k=1:numel(segments), segments{k}.Execution.RX.Replay.(field)=value; end
+end
+
+function reject(f,identifier)
+try, f(); catch cause
+    assert(string(cause.identifier)=="sixgr:link:"+identifier, ...
+        'test:WrongAuditRejection','Expected %s, received %s.',identifier,cause.identifier); return;
+end
+error('test:InvalidControlNoiseAccepted','Invalid control-noise evidence was accepted.');
+end
