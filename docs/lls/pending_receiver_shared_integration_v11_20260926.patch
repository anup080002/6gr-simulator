+function [sinr, reliability] = localPhysicalSINR(signal, disturbance)
+sinr = signal ./ disturbance;
+reliability = signal ./ (signal + disturbance);
+% A zero useful response carries no bit information. Positive signal with
+% exactly zero disturbance retains infinite SINR and unit reliability.
+sinr(signal==0) = 0;
