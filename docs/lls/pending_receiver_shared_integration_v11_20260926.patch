+++ b/tests/testCSIReportMeasurementAudit.m
@@ -0,0 +1,143 @@
+function ok = testCSIReportMeasurementAudit(retainedPointFolder)
+% Export-association fixtures only; no receiver outcomes are manufactured.
+if nargin<1, retainedPointFolder=""; end
+runtimeSource=fileread(which('sixgr.truth.runWaveformLinkBundle'));
+assert(contains(runtimeSource,'sixgr.link.bindCSIReportMeasurementAudit(csirsTrials, csiFeedbackReports, "DL")') && ...
+    ~contains(runtimeSource,'localBindCSIReportCausality('), ...
+    'Production finalization must use the identity-aware post-reception audit.');
+measurements = table([17;22;52],[1;1;1],[1;1;1],[3;4;4],[1;2;2], ...
+    [26;14;18],[0;0;0],repmat("csi-report-0",3,1),zeros(3,1), ...
+    'VariableNames',{'Slot','UEIndex','RNTI','CQI','RI','PMI','CRI', ...
+    'CSIReportConfigID','CSIConfigurationEpoch'});
+producer = struct('Direction',"DL",'UEIndex',1,'RNTI',1, ...
+    'ReportIdentity',"report_slot_24",'CSIReportConfigID',"csi-report-0", ...
+    'CSIConfigurationEpoch',0,'SourceSlot',17,'DueSlot',24,'CSIReferenceSlot',19);
+reports = table("DL",1,1,19,24,24,3,1,26,0,true, ...
+    "report_slot_24","csi-report-0",0,19, ...
+    "configured_CSI_reference_resource_not_UE_measurement_slot", ...
+    string(jsonencode(producer)),"delivered_to_runtime_scheduler", ...
+    'VariableNames',{'Direction','UEIndex','RNTI','SourceSlot','DueSlot', ...
+    'DeliveredSlot','CQI','RI','PMI','CRI','Processed','ReportIdentity', ...
+    'CSIReportConfigID','CSIConfigurationEpoch','CSIReferenceSlot', ...
+    'SourceSlotAuthority','UEReferenceRecordJSON','DeliveryStatus'});
+reports.CSIUCIDecodeOk = true;
+before = reports;
+T = sixgr.link.bindCSIReportMeasurementAudit(measurements,reports,"DL");
+assert(T.ReportCSIExactMatch(1) && nnz(T.ReportCSIExactMatch)==1);
+assert(T.ReportSourceSlot(1)==19 && T.ReportReferenceSlot(1)==19 && ...
+    T.ReportMeasurementSourceSlot(1)==17 && T.ReportDueSlot(1)==24);
+assert(T.ReportAssociationSource(1)== ...
+    "post_reception_retained_UE_producer_identity_not_gNB_input");
+assert(all(T.ReportBindingStatus(2:3)=="no_report_associated_with_measurement"));
+assert(isequal(reports,before),'An export join must never rewrite receiver/scheduler input.');
+
+% Missing optional producer audit cannot be replaced by nearest slot or
+% matching CQI/RI/PMI values. The actual received report remains intact.
+noProducer = reports; noProducer.UEReferenceRecordJSON(:)="";
+T = sixgr.link.bindCSIReportMeasurementAudit(measurements,noProducer,"DL");
+assert(~any(T.ReportCSIExactMatch) && all(T.ReportMatchCount==0));
+noProducer.SourceSlot(:)=17; noProducer.CSIReferenceSlot(:)=17;
+T = sixgr.link.bindCSIReportMeasurementAudit(measurements,noProducer,"DL");
+assert(~any(T.ReportCSIExactMatch),'Equal numeric slots do not establish UE measurement identity.');
+missingAuthority=noProducer; missingAuthority.SourceSlotAuthority(:)="";
+missingAuthority.SourceSignal="received_CSI_UCI";
+T=sixgr.link.bindCSIReportMeasurementAudit(measurements,missingAuthority,"DL");
+assert(~any(T.ReportCSIExactMatch),'A received report with unknown slot authority is not a legacy UE measurement.');
+
+% Producer identity, not favorable decoded values, selects the comparison.
+mismatch = reports; mismatch.CQI(:)=1;
+T = sixgr.link.bindCSIReportMeasurementAudit(measurements,mismatch,"DL");
+assert(T.ReportMeasurementSourceSlot(1)==17 && ~T.ReportCSIExactMatch(1) && ...
+    T.ReportBindingStatus(1)=="measured_csi_report_value_mismatch:CQI");
+failed = reports; failed.CSIUCIDecodeOk(:)=false;
+T = sixgr.link.bindCSIReportMeasurementAudit(measurements,failed,"DL");
+assert(T.ReportMatchCount(1)==1 && ~T.ReportCSIExactMatch(1) && ...
+    T.ReportBindingStatus(1)=="associated_report_without_successful_CSI_decode");
+bad = reports; bad.CSIConfigurationEpoch(:)=1;
+localReject(@()sixgr.link.bindCSIReportMeasurementAudit(measurements,bad,"DL"), ...
+    'sixgr:link:CSIProducerAuditIdentityMismatch');
+bad = reports; bad.ReportIdentity(:)="different_report";
+localReject(@()sixgr.link.bindCSIReportMeasurementAudit(measurements,bad,"DL"), ...
+    'sixgr:link:CSIProducerAuditIdentityMismatch');
+bad = reports; bad.UEReferenceRecordJSON(:)="invalid JSON";
+localReject(@()sixgr.link.bindCSIReportMeasurementAudit(measurements,bad,"DL"), ...
+    'sixgr:link:InvalidCSIProducerAudit');
+future = producer; future.SourceSlot=20;
+bad = reports; bad.UEReferenceRecordJSON(:)=string(jsonencode(future));
+localReject(@()sixgr.link.bindCSIReportMeasurementAudit(measurements,bad,"DL"), ...
+    'sixgr:link:InvalidCSIProducerAudit');
+localReject(@()sixgr.link.bindCSIReportMeasurementAudit(measurements,[reports;reports],"DL"), ...
+    'sixgr:link:AmbiguousCSIReportAudit');
+
+% A different UE or configuration cannot bind even with identical values.
+other = measurements; other.UEIndex(:)=2;
+T = sixgr.link.bindCSIReportMeasurementAudit(other,reports,"DL");
+assert(all(T.ReportMatchCount==0));
+other = measurements; other.CSIConfigurationEpoch(:)=1;
+T = sixgr.link.bindCSIReportMeasurementAudit(other,reports,"DL");
+assert(all(T.ReportMatchCount==0));
+
+% Existing non-shared producer exports retain their measurement-slot clock.
+legacy = reports; legacy.SourceSlot(:)=17; legacy.SourceSlotAuthority(:)="";
+legacy.UEReferenceRecordJSON(:)="";
+T = sixgr.link.bindCSIReportMeasurementAudit(measurements,legacy,"DL");
+assert(T.ReportCSIExactMatch(1) && T.ReportAssociationSource(1)=="producer_measurement_slot_identity");
+
+% Multiple genuine reporting occasions may reuse one observation. Preserve
+% their count and choose latest by due time, never by file order or values.
+laterProducer=producer; laterProducer.ReportIdentity="report_slot_29";
+laterProducer.DueSlot=29; laterProducer.CSIReferenceSlot=24;
+later=reports; later.ReportIdentity(:)="report_slot_29"; later.DueSlot(:)=29;
+later.DeliveredSlot(:)=29; later.CSIReferenceSlot(:)=24; later.SourceSlot(:)=24;
+later.UEReferenceRecordJSON(:)=string(jsonencode(laterProducer));
+T = sixgr.link.bindCSIReportMeasurementAudit(measurements,[later;reports],"DL");
+assert(T.ReportMatchCount(1)==2 && T.ReportDueSlot(1)==29);
+fixtureRoot=tempname(fullfile(pwd,'logs')); mkdir(fixtureRoot);
+fixtureCSV=fullfile(fixtureRoot,'fixture_csi_measurement_audit.csv');
+sixgr.util.csvWriteTable(fixtureCSV,T,'PreserveSchema',true);
+roundtrip=readtable(fixtureCSV,'TextType','string');
+assert(roundtrip.ReportSourceSlot(1)==24 && roundtrip.ReportReferenceSlot(1)==24 && ...
+    roundtrip.ReportMeasurementSourceSlot(1)==17 && roundtrip.ReportMatchCount(1)==2 && ...
+    roundtrip.ReportCSIExactMatch(1)==1 && ...
+    roundtrip.ReportComparisonPlane(1)=="receiver_decoded_fields_vs_retained_UE_measurement");
+fprintf('CSI_AUDIT_EXPORT_FIXTURE=%s\n',fixtureCSV);
+
+if strlength(string(retainedPointFolder))>0
+    measured = readtable(fullfile(retainedPointFolder,'air_interface','csv','csi_rs_trials.csv'),'TextType','string');
+    for reportFile=["csi_feedback_reports.csv","received_csi_reports.csv"]
+    received = readtable(fullfile(retainedPointFolder,'air_interface','csv',reportFile),'TextType','string');
+    before = received;
+    T = sixgr.link.bindCSIReportMeasurementAudit(measured,received,"DL");
+    assert(isequaln(before,received));
+    for field=["CQI","RI","PMI","CRI","SINR_dB","ConfiguredSNR_dB","AppliedAWGNSNR_dB"]
+        assert(isequaln(T.(field),measured.(field)), ...
+            'The report audit must not alter physical measurements or their operating point.');
+    end
+    eligible = strlength(strtrim(string(received.UEReferenceRecordJSON)))>0;
+    assert(any(eligible) && nnz(T.ReportMatchCount)>0,'Retained run must exercise an actual producer/receiver join.');
+    for j=find(eligible).'
+        p=jsondecode(char(received.UEReferenceRecordJSON(j)));
+        hit=find(T.Slot==p.SourceSlot & T.UEIndex==p.UEIndex);
+        assert(isscalar(hit) && T.ReportMeasurementSourceSlot(hit)==p.SourceSlot && ...
+            T.ReportSourceSlot(hit)==received.SourceSlot(j));
+        left=double(measured{hit,{'CQI','RI','PMI','CRI'}});
+        right=double(received{j,{'CQI','RI','PMI','CRI'}});
+        expected=all(isfinite(left)) && all(isfinite(right)) && ...
+            isequal(left,right) && received.CSIUCIDecodeOk(j)==1;
+        assert(T.ReportCSIExactMatch(hit)==expected, ...
+            'Retained measured/decoded values, not a constant status, must determine the comparison.');
+    end
+    fprintf('RETAINED_CSI_AUDIT_SOURCE=%s MATCHED=%d EXACT=%d UNMATCHED=%d TOTAL_MEASUREMENTS=%d\n', ...
+        reportFile,nnz(T.ReportMatchCount),nnz(T.ReportCSIExactMatch),nnz(T.ReportMatchCount==0),height(T));
+    end
+end
+ok=true;
+fprintf('CSI_REPORT_MEASUREMENT_AUDIT_PASS: configured reference clock is not UE observation clock.\n');
+end
+
+function localReject(call,identifier)
+try, call(); catch exception
+    assert(strcmp(exception.identifier,identifier),'Unexpected failure: %s',exception.identifier); return;
+end
+error('testCSIReportMeasurementAudit:MissingRejection','Invalid audit identity was accepted.');
+end
