diff --git a/+sixgr/+mimo/buildAppliedPrecoderInventory.m b/+sixgr/+mimo/buildAppliedPrecoderInventory.m
new file mode 100644
--- /dev/null
+++ b/+sixgr/+mimo/buildAppliedPrecoderInventory.m
@@ -0,0 +1,70 @@
+function T = buildAppliedPrecoderInventory(rankTrials)
+% Group executed data-precoder identities; never reconstruct beam weights.
+% This is not an SSB/CSI-RS candidate sweep or an array-pattern measurement.
+% Preserve the applied matrix digest, including multiple matrices for one
+% beam label. A rank-two precoder matrix must not be called a weight vector.
+assert(istable(rankTrials),'sixgr:mimo:InvalidPrecoderInventoryInput', ...
+    'Applied-precoder inventory requires runtime trial rows.');
+row=struct('RunId',"",'Direction',"",'BeamId',"", ...
+    'AppliedPrecoderMatrixSHA256',"",'PrecoderDigestDomain',"",'EvidenceKind', ...
+    "applied_data_precoder_inventory_not_beam_sweep", ...
+    'MatrixIdentitySource',"air_interface_trial_applied_precoder_matrix", ...
+    'SourceTrialCount',0,'SourceTrialIds',"",'SourceRowHashes',"", ...
+    'Status',"",'FailureReason',"");
+rows=repmat(row,0,1);
+if isempty(rankTrials), T=struct2table(rows); return; end
+required=["RunId","Direction","TrialId","BeamId", ...
+    "AppliedPrecoderMatrixSHA256","SourceRowsHash"];
+assert(all(ismember(required,string(rankTrials.Properties.VariableNames))), ...
+    'sixgr:mimo:MissingPrecoderInventoryEvidence', ...
+    'Require run/trial identity, selected beam label and the applied-matrix evidence column.');
+for flag=["ProxyUsed","FallbackUsed","SyntheticUsed"]
+    if ismember(flag,string(rankTrials.Properties.VariableNames))
+        assert(all(double(rankTrials.(flag))==0,'all'), ...
+            'sixgr:mimo:NonPhysicalPrecoderInventory', ...
+            'Nonphysical/unknown trial rows cannot establish applied precoders.');
+    end
+end
+runId=string(rankTrials.RunId); direction=upper(string(rankTrials.Direction));
+beam=string(rankTrials.BeamId); beam(ismissing(beam))="";
+digest=lower(strtrim(string(rankTrials.AppliedPrecoderMatrixSHA256)));
+digest(ismissing(digest))="";
+domain=strings(height(rankTrials),1);
+if ismember('PrecoderDigestDomain',rankTrials.Properties.VariableNames)
+    domain=strtrim(string(rankTrials.PrecoderDigestDomain));
+    domain(ismissing(domain))="";
+end
+assert(all(ismember(direction,["DL","UL"])) && ...
+    all(~ismissing(runId) & strlength(strtrim(runId))>0), ...
+    'sixgr:mimo:InvalidPrecoderInventoryIdentity','Every row needs run and direction identity.');
+trialId=double(rankTrials.TrialId);
+assert(all(isfinite(trialId) & trialId>=0 & trialId==fix(trialId)), ...
+    'sixgr:mimo:InvalidPrecoderInventoryIdentity','Every source trial needs an explicit integer identity.');
+valid=~cellfun(@isempty,regexp(cellstr(digest),'^[a-f0-9]{64}$','once'));
+assert(all(valid | strlength(digest)==0), ...
+    'sixgr:mimo:InvalidAppliedPrecoderDigest','Malformed matrix evidence must not be replaced by a beam-label hash.');
+keys=table(runId,direction,beam,digest,domain);
+[~,first,group]=unique(keys,'rows','stable');
+for g=1:numel(first)
+    i=first(g); hits=find(group==g);
+    r=row; r.RunId=runId(i); r.Direction=direction(i); r.BeamId=beam(i);
+    r.AppliedPrecoderMatrixSHA256=digest(i);
+    r.PrecoderDigestDomain=domain(i);
+    r.SourceTrialCount=numel(hits);
+    r.SourceTrialIds=strjoin(string(trialId(hits)),"|");
+    source=string(rankTrials.SourceRowsHash(hits));
+    assert(all(~ismissing(source) & strlength(strtrim(source))>0), ...
+        'sixgr:mimo:MissingPrecoderInventoryEvidence','Do not manufacture source-row lineage.');
+    r.SourceRowHashes=strjoin(unique(source,'stable'),"|");
+    r.Status="pass";
+    if ~valid(i)
+        r.Status="fail";
+        r.FailureReason="applied_precoder_matrix_digest_missing";
+    elseif strlength(domain(i))==0
+        r.Status="fail";
+        r.FailureReason="applied_precoder_matrix_domain_missing";
+    end
+    rows(end+1,1)=r; %#ok<AGROW>
+end
+T=struct2table(rows);
+end
diff --git a/tests/testAppliedPrecoderInventory.m b/tests/testAppliedPrecoderInventory.m
new file mode 100644
--- /dev/null
+++ b/tests/testAppliedPrecoderInventory.m
@@ -0,0 +1,75 @@
+function ok = testAppliedPrecoderInventory(retainedPointFolder)
+% Explicit matrix/export fixtures, not physical beam-sweep qualification.
+if nargin<1, retainedPointFolder=""; end
+W1=[1;1i]/sqrt(2); W2=[1;-1i]/sqrt(2);
+h1=sixgr.phy.mimo.MatrixContract.digest(W1);
+h2=sixgr.phy.mimo.MatrixContract.digest(W2);
+raw=table(repmat("fixture",4,1),["DL";"DL";"DL";"UL"], ...
+    [1;2;3;1],repmat("7",4,1),[h1;h1;h2;h1], ...
+    ["source1";"source2";"source3";"source4"], ...
+    'VariableNames',{'RunId','Direction','TrialId','BeamId', ...
+    'AppliedPrecoderMatrixSHA256','SourceRowsHash'});
+raw.PrecoderDigestDomain=repmat("logical_antenna_port",4,1);
+before=raw;
+T=sixgr.mimo.buildAppliedPrecoderInventory(raw);
+assert(isequal(raw,before) && height(T)==3);
+assert(isequal(T.SourceTrialCount,[2;1;1]) && all(T.Status=="pass"));
+assert(T.AppliedPrecoderMatrixSHA256(1)==h1 && T.AppliedPrecoderMatrixSHA256(2)==h2);
+assert(T.SourceTrialIds(1)=="1|2" && T.SourceRowHashes(1)=="source1|source2");
+assert(all(T.PrecoderDigestDomain=="logical_antenna_port"));
+assert(~ismember('WeightVectorHash',T.Properties.VariableNames), ...
+    'A matrix digest must not be exported as a fabricated vector identity.');
+assert(all(T.EvidenceKind=="applied_data_precoder_inventory_not_beam_sweep"));
+% Renaming a beam does not change its physically applied matrix.
+renamed=raw; renamed.BeamId(:)="different_label";
+R=sixgr.mimo.buildAppliedPrecoderInventory(renamed);
+assert(isequal(R.AppliedPrecoderMatrixSHA256,T.AppliedPrecoderMatrixSHA256));
+% A different run must retain its independent source-trial identities.
+other=raw(1,:); other.RunId="other_run";
+R=sixgr.mimo.buildAppliedPrecoderInventory([raw;other]);
+assert(height(R)==4 && R.SourceTrialCount(end)==1);
+% Type-II/explicit matrices need not have a scalar beam/PMI label.
+matrixOnly=raw(3,:); matrixOnly.BeamId="";
+R=sixgr.mimo.buildAppliedPrecoderInventory(matrixOnly);
+assert(R.BeamId=="" && R.AppliedPrecoderMatrixSHA256==h2 && R.Status=="pass");
+noDomain=removevars(matrixOnly,'PrecoderDigestDomain');
+R=sixgr.mimo.buildAppliedPrecoderInventory(noDomain);
+assert(R.Status=="fail" && R.PrecoderDigestDomain=="" && ...
+    R.FailureReason=="applied_precoder_matrix_domain_missing");
+% Do not invent a matrix from a perfectly valid beam label.
+missing=raw(1,:); missing.AppliedPrecoderMatrixSHA256="";
+R=sixgr.mimo.buildAppliedPrecoderInventory(missing);
+assert(R.Status=="fail" && R.AppliedPrecoderMatrixSHA256=="" && ...
+    R.FailureReason=="applied_precoder_matrix_digest_missing");
+bad=raw; bad.AppliedPrecoderMatrixSHA256(1)="not_a_matrix_digest";
+localReject(@()sixgr.mimo.buildAppliedPrecoderInventory(bad), ...
+    'sixgr:mimo:InvalidAppliedPrecoderDigest');
+bad=raw; bad.ProxyUsed=[false;true;false;false];
+localReject(@()sixgr.mimo.buildAppliedPrecoderInventory(bad), ...
+    'sixgr:mimo:NonPhysicalPrecoderInventory');
+assert(isempty(sixgr.mimo.buildAppliedPrecoderInventory(raw([],:))));
+if strlength(string(retainedPointFolder))>0
+    path=fullfile(retainedPointFolder,'beamforming','csv','rank_layer_trials.csv');
+    measured=readtable(path,'TextType','string');
+    R=sixgr.mimo.buildAppliedPrecoderInventory(measured);
+    assert(sum(R.SourceTrialCount)==height(measured));
+    for i=1:height(R)
+        mask=string(measured.RunId)==R.RunId(i) & ...
+            string(measured.Direction)==R.Direction(i) & ...
+            string(measured.BeamId)==R.BeamId(i) & ...
+            string(measured.AppliedPrecoderMatrixSHA256)==R.AppliedPrecoderMatrixSHA256(i);
+        assert(nnz(mask)==R.SourceTrialCount(i));
+    end
+    fprintf('RETAINED_PRECODER_INVENTORY rows=%d identities=%d missing_digest=%d\n', ...
+        height(measured),height(R),nnz(R.Status=="fail"));
+end
+ok=true;
+fprintf('APPLIED_PRECODER_INVENTORY_PASS actual_digest_identity_not_beam_label_or_sweep\n');
+end
+
+function localReject(call,identifier)
+try, call(); catch e
+    assert(strcmp(e.identifier,identifier),'Unexpected rejection: %s',e.identifier); return;
+end
+error('test:MissingPrecoderInventoryRejection','Invalid matrix evidence was accepted.');
+end
diff --git a/tools/applied_precoder_inventory_audit.py b/tools/applied_precoder_inventory_audit.py
new file mode 100644
--- /dev/null
+++ b/tools/applied_precoder_inventory_audit.py
@@ -0,0 +1,83 @@
+"""Reconcile an applied data-precoder inventory, not a beam-sweep claim."""
+from collections import defaultdict
+import math
+import re
+
+
+def reconcile_inventory(inventory, trials):
+    """Return failures; never replace missing matrix identity with a label hash."""
+    fields = ('RunId', 'Direction', 'BeamId', 'AppliedPrecoderMatrixSHA256',
+              'PrecoderDigestDomain')
+    required = set(fields) | {'SourceTrialCount', 'SourceTrialIds',
+                              'SourceRowHashes', 'EvidenceKind',
+                              'MatrixIdentitySource', 'Status', 'FailureReason'}
+    failures = []
+    expected = defaultdict(list)
+
+    def text(row, field):
+        value = str(row.get(field, '')).strip()
+        return '' if value in ('<missing>', 'None') else value
+
+    def key(row):
+        return (text(row, 'RunId'), text(row, 'Direction').upper(),
+                text(row, 'BeamId'), text(row, 'AppliedPrecoderMatrixSHA256').lower(),
+                text(row, 'PrecoderDigestDomain'))
+
+    def integer(value):
+        try:
+            n = float(value)
+            return int(n) if math.isfinite(n) and n >= 0 and n == int(n) else None
+        except (TypeError, ValueError, OverflowError):
+            return None
+
+    for i, trial in enumerate(trials, 1):
+        if not {'RunId', 'Direction', 'TrialId', 'BeamId',
+                'AppliedPrecoderMatrixSHA256', 'SourceRowsHash'} <= trial.keys():
+            failures.append(f'trial={i}:missing_source_identity_columns')
+            continue
+        if integer(trial['TrialId']) is None or not text(trial, 'SourceRowsHash'):
+            failures.append(f'trial={i}:invalid_source_trial_identity')
+        for flag in ('ProxyUsed', 'FallbackUsed', 'SyntheticUsed'):
+            if flag in trial and str(trial[flag]).lower() not in ('0', 'false'):
+                failures.append(f'trial={i}:nonphysical_or_unknown_{flag}')
+        expected[key(trial)].append(trial)
+
+    seen = set()
+    for i, row in enumerate(inventory, 1):
+        prefix = f'row={i}:'
+        if not required <= row.keys():
+            failures.append(prefix + 'missing_inventory_columns')
+            continue
+        identity = key(row)
+        if identity in seen:
+            failures.append(prefix + 'duplicate_matrix_inventory_identity')
+        seen.add(identity)
+        source = expected.get(identity)
+        if not source:
+            failures.append(prefix + 'matrix_or_domain_not_executed_source')
+            continue
+        if integer(row['SourceTrialCount']) != len(source):
+            failures.append(prefix + 'source_trial_count_mismatch')
+        ids = [integer(v) for v in text(row, 'SourceTrialIds').split('|')]
+        if ids != [integer(r['TrialId']) for r in source]:
+            failures.append(prefix + 'source_trial_ids_mismatch')
+        hashes = list(dict.fromkeys(text(r, 'SourceRowsHash') for r in source))
+        if text(row, 'SourceRowHashes').split('|') != hashes:
+            failures.append(prefix + 'source_row_hashes_mismatch')
+        if text(row, 'EvidenceKind') != 'applied_data_precoder_inventory_not_beam_sweep':
+            failures.append(prefix + 'inventory_mislabeled_as_beam_measurement')
+        if text(row, 'MatrixIdentitySource') != 'air_interface_trial_applied_precoder_matrix':
+            failures.append(prefix + 'matrix_identity_source_mismatch')
+        digest, domain = identity[3:]
+        reason = ''
+        if not re.fullmatch('[a-f0-9]{64}', digest):
+            reason = 'applied_precoder_matrix_digest_missing'
+            if digest:
+                failures.append(prefix + 'malformed_applied_matrix_digest')
+        elif not domain:
+            reason = 'applied_precoder_matrix_domain_missing'
+        if text(row, 'Status') != ('fail' if reason else 'pass') or text(row, 'FailureReason') != reason:
+            failures.append(prefix + 'matrix_evidence_status_mismatch')
+    if seen != set(expected):
+        failures.append('executed_matrix_identity_set_mismatch')
+    return failures
diff --git a/tests/test_applied_precoder_inventory_audit.py b/tests/test_applied_precoder_inventory_audit.py
