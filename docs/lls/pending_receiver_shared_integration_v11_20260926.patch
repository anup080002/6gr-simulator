@@ -0,0 +1,81 @@
+"""Audit fixtures only; these are not generated physical result rows."""
+import copy
+import importlib.util
+from pathlib import Path
+import unittest
+
+spec = importlib.util.spec_from_file_location('inventory_audit',
+    Path(__file__).resolve().parents[1] / 'tools/applied_precoder_inventory_audit.py')
+module = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(module)
+
+
+class InventoryAuditTests(unittest.TestCase):
+    def setUp(self):
+        self.trials = [dict(RunId='fixture', Direction='DL', TrialId=str(i + 1),
+            BeamId='7', AppliedPrecoderMatrixSHA256=digest,
+            PrecoderDigestDomain='logical_port', SourceRowsHash='c' * 64)
+            for i, digest in enumerate(['a' * 64, 'a' * 64, 'b' * 64])]
+        self.rows = [dict(RunId='fixture', Direction='DL', BeamId='7',
+            AppliedPrecoderMatrixSHA256=digest, PrecoderDigestDomain='logical_port',
+            SourceTrialCount=count, SourceTrialIds=ids, SourceRowHashes='c' * 64,
+            EvidenceKind='applied_data_precoder_inventory_not_beam_sweep',
+            MatrixIdentitySource='air_interface_trial_applied_precoder_matrix',
+            Status='pass', FailureReason='')
+            for digest, count, ids in [('a' * 64, 2, '1|2'), ('b' * 64, 1, '3')]]
+
+    def audit(self, rows=None, trials=None):
+        return module.reconcile_inventory(self.rows if rows is None else rows,
+            self.trials if trials is None else trials)
+
+    def test_two_matrices_with_same_label(self):
+        self.assertEqual(self.audit(), [])
+
+    def test_valid_looking_label_hash_is_not_a_matrix(self):
+        self.rows[0]['AppliedPrecoderMatrixSHA256'] = 'd' * 64
+        self.assertTrue(self.audit())
+
+    def test_collapsing_same_beam_loses_executed_matrix(self):
+        self.assertTrue(self.audit(self.rows[:1]))
+
+    def test_wrong_domain_is_not_equivalent(self):
+        self.rows[0]['PrecoderDigestDomain'] = 'physical_element'
+        self.assertTrue(self.audit())
+
+    def test_duplicate_identity_rejected(self):
+        self.assertTrue(self.audit(self.rows + [self.rows[0]]))
+
+    def test_lineage_and_scope_poisoning(self):
+        for field, value in [('SourceTrialCount', 'NaN'), ('SourceTrialIds', '2|1'),
+                ('SourceRowHashes', 'd' * 64), ('EvidenceKind', 'measured_beam_sweep'),
+                ('MatrixIdentitySource', 'configured_beam_label')]:
+            with self.subTest(field=field):
+                bad = copy.deepcopy(self.rows)
+                bad[0][field] = value
+                self.assertTrue(self.audit(bad))
+
+    def test_missing_digest_remains_failed(self):
+        self.trials[2]['AppliedPrecoderMatrixSHA256'] = ''
+        self.rows[1]['AppliedPrecoderMatrixSHA256'] = ''
+        self.rows[1].update(Status='fail', FailureReason='applied_precoder_matrix_digest_missing')
+        self.assertEqual(self.audit(), [])
+        self.rows[1].update(Status='pass', FailureReason='')
+        self.assertTrue(self.audit())
+
+    def test_unknown_domain_is_not_invented(self):
+        self.trials[2].pop('PrecoderDigestDomain')
+        self.rows[1].update(PrecoderDigestDomain='', Status='fail',
+            FailureReason='applied_precoder_matrix_domain_missing')
+        self.assertEqual(self.audit(), [])
+
+    def test_nonphysical_rows_rejected(self):
+        self.trials[0]['ProxyUsed'] = '1'
+        self.assertTrue(self.audit())
+
+    def test_empty_does_not_invent_inventory(self):
+        self.assertEqual(self.audit([], []), [])
+        self.assertTrue(self.audit([], self.trials))
+
+
+if __name__ == '__main__':
+    unittest.main()

