+function T = bindCSIReportMeasurementAudit(T, reports, direction)
+% Post-reception export join, never an input to UCI decoding or scheduling.
+% The gNB SourceSlot can denote a configured CSI reference resource rather
+% than the UE's selected CSI-RS observation. Keep both clocks and require the
+% retained producer identity before claiming a measured-to-received match.
+if ~(istable(T) && ~isempty(T)), return; end
+n = height(T);
+for name = ["ReportSourceSlot","ReportMeasurementSourceSlot","ReportReferenceSlot", ...
+        "ReportDueSlot","ReportDeliveredSlot"]
+    T.(name) = nan(n,1);
+end
+for name = ["ReportProcessed","ReportCQIExactMatch","ReportRIExactMatch", ...
+        "ReportPMIExactMatch","ReportCRIExactMatch","ReportCSIExactMatch"]
+    T.(name) = false(n,1);
+end
+T.ReportStatus = repmat("not_associated",n,1);
+T.ReportIdentity = strings(n,1);
+T.ReportAssociationSource = strings(n,1);
+T.ReportComparisonPlane = strings(n,1);
+T.ReportMatchCount = zeros(n,1);
+T.ReportBindingStatus = repmat("no_report_associated_with_measurement",n,1);
+if ~(istable(reports) && ~isempty(reports)), return; end
+required = ["Direction","UEIndex","SourceSlot","DueSlot","CQI","RI","PMI","CRI","Processed"];
+if ~all(ismember(required,string(reports.Properties.VariableNames)))
+    T.ReportBindingStatus(:) = "report_schema_incomplete";
+    return;
+end
+assert(all(ismember(["Slot","UEIndex"],string(T.Properties.VariableNames))), ...
+    'sixgr:link:CSIMeasurementAuditIdentityRequired','Measured CSI rows need UE and actual observation slot.');
+measurementSlot = nan(height(reports),1);
+association = strings(height(reports),1);
+for j = 1:height(reports)
+    authority = localText(reports,"SourceSlotAuthority",j);
+    if authority == "configured_CSI_reference_resource_not_UE_measurement_slot"
+        token = localText(reports,"UEReferenceRecordJSON",j);
+        if strlength(token) == 0, continue; end
+        try, producer = jsondecode(char(token));
+        catch
+            error('sixgr:link:InvalidCSIProducerAudit','The retained UE CSI audit is not valid JSON.');
+        end
+        assert(isstruct(producer) && isscalar(producer), ...
+            'sixgr:link:InvalidCSIProducerAudit','One report needs one retained producer record.');
+        for field = ["Direction","UEIndex","RNTI","ReportIdentity", ...
+                "CSIReportConfigID","CSIConfigurationEpoch","DueSlot","CSIReferenceSlot"]
+            assert(isfield(producer,field) && ismember(field,string(reports.Properties.VariableNames)), ...
+                'sixgr:link:InvalidCSIProducerAudit','Incomplete producer/report audit identity: %s.',field);
+            observed = reports.(field)(j,:);
+            expected = producer.(field);
+            assert(localSameIdentity(observed,expected), ...
+                'sixgr:link:CSIProducerAuditIdentityMismatch', ...
+                'Retained producer does not belong to this received report: %s.',field);
+        end
+        assert(strlength(string(producer.ReportIdentity))>0 && ...
+            isfield(producer,'SourceSlot') && isnumeric(producer.SourceSlot) && ...
+            isscalar(producer.SourceSlot) && isfinite(producer.SourceSlot) && ...
+            producer.SourceSlot>=1 && producer.SourceSlot==fix(producer.SourceSlot) && ...
+            producer.SourceSlot<=double(reports.SourceSlot(j)) && ...
+            double(reports.SourceSlot(j))==double(producer.CSIReferenceSlot) && ...
+            double(producer.CSIReferenceSlot)<double(producer.DueSlot), ...
+            'sixgr:link:InvalidCSIProducerAudit','The UE measurement must precede its configured report reference/due slot.');
+        if isfield(producer,'ServingCell') && ismember('ServingCell',reports.Properties.VariableNames)
+            assert(localSameIdentity(reports.ServingCell(j),producer.ServingCell), ...
+                'sixgr:link:CSIProducerAuditIdentityMismatch','Producer and received report belong to different cells.');
+        end
+        measurementSlot(j) = double(producer.SourceSlot);
+        association(j) = "post_reception_retained_UE_producer_identity_not_gNB_input";
+    elseif (strlength(authority)==0 || authority=="UE_measurement_slot") && ...
+            localText(reports,"SourceSignal",j)~="received_CSI_UCI"
+        % Legacy producer records carry the measurement clock directly.
+        measurementSlot(j) = double(reports.SourceSlot(j));
+        association(j) = "producer_measurement_slot_identity";
+    end
+end
+for i = 1:n
+    mask = upper(string(reports.Direction))==upper(string(direction)) & ...
+        double(reports.UEIndex)==double(T.UEIndex(i)) & ...
+        measurementSlot==double(T.Slot(i));
+    for field = ["Direction","RNTI","ServingCell","CSIReportConfigID","CSIConfigurationEpoch"]
+        if ismember(field,string(T.Properties.VariableNames)) && ...
+                ismember(field,string(reports.Properties.VariableNames))
+            for j = find(mask).'
+                mask(j) = localSameIdentity(T.(field)(i,:),reports.(field)(j,:));
+            end
+        end
+    end
+    hits = find(mask);
+    if isempty(hits), continue; end
+    % A measurement may supply multiple periodic reports. The original
+    % report table retains every occasion; this row summarizes the latest.
+    due = double(reports.DueSlot(hits));
+    assert(all(isfinite(due)), 'sixgr:link:InvalidCSIProducerAudit','A matched report needs a finite due slot.');
+    last = hits(due==max(due));
+    assert(isscalar(last), 'sixgr:link:AmbiguousCSIReportAudit', ...
+        'Do not select among duplicate report identities by payload values or row order.');
+    j = last;
+    T.ReportMatchCount(i) = numel(hits);
+    T.ReportSourceSlot(i) = double(reports.SourceSlot(j));
+    T.ReportMeasurementSourceSlot(i) = measurementSlot(j);
+    T.ReportReferenceSlot(i) = localNumber(reports,"CSIReferenceSlot",j);
+    T.ReportDueSlot(i) = double(reports.DueSlot(j));
+    T.ReportDeliveredSlot(i) = localNumber(reports,"DeliveredSlot",j);
+    T.ReportProcessed(i) = logical(reports.Processed(j));
+    T.ReportAssociationSource(i) = association(j);
+    T.ReportIdentity(i) = localText(reports,"ReportIdentity",j);
+    status = localText(reports,"DeliveryStatus",j);
+    if strlength(status)==0
+        status = "pending_causal_feedback_delay";
+        if T.ReportProcessed(i), status = "delivered_to_runtime_scheduler"; end
+    end
+    T.ReportStatus(i) = status;
+    T.ReportComparisonPlane(i) = "UE_producer_report_fields_not_receiver_verification";
+    if association(j)=="post_reception_retained_UE_producer_identity_not_gNB_input"
+        T.ReportComparisonPlane(i) = "receiver_decoded_fields_vs_retained_UE_measurement";
+        if ~ismember('CSIUCIDecodeOk',reports.Properties.VariableNames) || ...
+                ~isequal(double(reports.CSIUCIDecodeOk(j)),1)
+            T.ReportBindingStatus(i) = "associated_report_without_successful_CSI_decode";
+            continue;
+        end
+    end
+    names = ["CQI","RI","PMI","CRI"];
+    exact = false(1,4);
+    for k = 1:numel(names)
+        name = names(k);
+        if ismember(name,string(T.Properties.VariableNames))
+            a = double(T.(name)(i,:)); b = double(reports.(name)(j,:));
+            exact(k) = isequal(size(a),size(b)) && all(isfinite(a),'all') && ...
+                all(isfinite(b),'all') && all(abs(a-b)<=1e-9,'all');
+        end
+        T.("Report"+name+"ExactMatch")(i) = exact(k);
+    end
+    T.ReportCSIExactMatch(i) = all(exact);
+    T.ReportBindingStatus(i) = "exact_measured_csi_report_bound";
+    if ~all(exact)
+        T.ReportBindingStatus(i) = "measured_csi_report_value_mismatch:"+strjoin(names(~exact),"+");
+    end
+end
+end
+
+function tf = localSameIdentity(a,b)
+if isnumeric(a) || islogical(a)
+    tf = (isnumeric(b) || islogical(b)) && isequal(size(a),size(b)) && ...
+        all(isfinite(double(a)),'all') && all(isfinite(double(b)),'all') && ...
+        isequal(double(a),double(b));
+else
+    tf = isequal(string(a),string(b));
+end
+end
+
+function value = localText(T,name,row)
+value = "";
+if ismember(name,string(T.Properties.VariableNames)), value = string(T.(name)(row)); end
+if ismissing(value), value = ""; end
+end
+
+function value = localNumber(T,name,row)
+value = NaN;
+if ismember(name,string(T.Properties.VariableNames)), value = double(T.(name)(row)); end
+end
diff --git a/tests/testCSIReportMeasurementAudit.m b/tests/testCSIReportMeasurementAudit.m
