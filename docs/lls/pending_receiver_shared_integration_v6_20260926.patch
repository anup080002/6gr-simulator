+function localValidateJointPolicy(policy)
+id='sixgr:phy:pucch:InvalidJointShortUCIPolicy';
+assert(all(isfield(policy,{'algorithm','target_false_alarm_probability','minimum_word_posterior'})) && ...
+    isscalar(string(policy.algorithm)) && string(policy.algorithm)=="flat_joint_short_uci_v1", ...
+    id,'Supply the explicit supported joint short-UCI algorithm and both probability gates.');
+alpha=policy.target_false_alarm_probability; confidence=policy.minimum_word_posterior;
+assert(isnumeric(alpha) && isreal(alpha) && isscalar(alpha) && isfinite(alpha) && alpha>0 && alpha<1 && ...
+    isnumeric(confidence) && isreal(confidence) && isscalar(confidence) && ...
+    isfinite(confidence) && confidence>0 && confidence<=1, ...
+    id,'False-alarm probability must be in (0,1); minimum word posterior must be in (0,1].');
+end
