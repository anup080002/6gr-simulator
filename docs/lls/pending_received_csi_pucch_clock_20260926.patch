diff --git a/+sixgr/+link/receivePUCCHObservation.m b/+sixgr/+link/receivePUCCHObservation.m
index 83009447..25921c30 100644
--- a/+sixgr/+link/receivePUCCHObservation.m
+++ b/+sixgr/+link/receivePUCCHObservation.m
@@ -38,7 +38,8 @@ assert(~isempty(policy),'sixgr:link:PUCCHDetectionYAMLAuthorityRequired', ...
 [threshold,thresholdSource]=sixgr.phy.pucch.resolveDetectionThreshold(assignment,policy);
 args={'NoiseVariance',NaN,'ChannelProfile',sixgr.channel.resolveConcreteProfile(cfg), ...
     'DetectionThreshold',threshold};
-timing=[];
+timing=[];
+priorRejection="";
 if assignment.Format==0
     if isempty(prior) && receiverOnly && context.HARQACKBits==0 && context.SRBits==1 && ...
             context.CSIPart1Bits==0 && context.CSIPart2Bits==0
@@ -59,14 +60,38 @@ if assignment.Format==0
         [raw,timing]=prior.alignCompletedObservation(cfg,observation,slot0);
     end
     args=[args {'NoiseVarianceMode','noncoherent_correlation'}];
-else
-    % Received DM-RS, not injected noise/covariance or TX pilot samples.
-    % The full actual capture bounds timing search; no padding is allowed.
-    args=[args {'NoiseVarianceMode','received_dmrs_estimate', ...
-        'TimingSearchWindowSamples',[0 size(raw,1)-(stop-first)]}];
-end
-rx=sixgr.phy.pucch.PUCCHReceiver.receive(raw,carrier,assignment,context,args{:});
-if ~isempty(timing), rx.ReceiveTiming=timing; end
+else
+    % Received DM-RS, not injected noise/covariance or TX pilot samples.
+    args=[args {'NoiseVarianceMode','received_dmrs_estimate'}];
+    if ~isempty(prior)
+        assert(isa(prior,'sixgr.phy.sync.ReceivedULTimingReference') && isscalar(prior), ...
+            'sixgr:link:InvalidPUCCHTimingPrior','A timing prior must be a retained received UL pilot clock.');
+        try
+            [raw,timing]=prior.alignCompletedObservation(cfg,observation,slot0);
+        catch cause
+            % These states make an earlier clock inapplicable, not a new
+            % timing measurement. Formats with DM-RS can acquire their own
+            % known pilots. Malformed configuration and other errors stay fatal.
+            inapplicable=["sixgr:phy:sync:StaleULTimingReference", ...
+                "sixgr:phy:sync:ULTimingReferenceIdentityMismatch", ...
+                "sixgr:phy:sync:FutureULTimingReference", ...
+                "sixgr:phy:sync:IncompletePriorAlignedULObservation"];
+            if ~any(string(cause.identifier)==inapplicable), rethrow(cause); end
+            priorRejection=string(cause.identifier);
+        end
+    end
+    if isempty(timing)
+        % Full actual capture bounds acquisition; no padding or TX timing.
+        args=[args {'TimingSearchWindowSamples',[0 size(raw,1)-(stop-first)]}];
+    end
+end
+rx=sixgr.phy.pucch.PUCCHReceiver.receive(raw,carrier,assignment,context,args{:});
+if ~isempty(timing), rx.ReceiveTiming=timing; end
+if assignment.Format>=1
+    rx.ReceiveTiming.PriorClockProvided=~isempty(prior);
+    rx.ReceiveTiming.PriorClockApplied=~isempty(timing);
+    rx.ReceiveTiming.PriorClockRejectionReason=priorRejection;
+end
 rx.DetectionThresholdSource=thresholdSource;
 rx.ReceiverObservationStartSample=observation.StartSample;
 rx.ReceiverObservationEndSampleExclusive=observation.EndSampleExclusive;
